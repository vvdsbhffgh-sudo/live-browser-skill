    "groq_free": {
      "note": "Per-model: main chat models 30 req/min, 1000/day, 8K tok/min, 200K tok/day; Whisper 20 req/min, 2000/day; Orpheus 10 req/min, 100/day; safeguard 3 req/min. Limits apply per organization, not per key."
    },
    "gemini_free": {
      "note": "Per-model quotas in Google AI Studio; check current numbers there."
    },
    "maxQueuedTasks": 20,
    "neverAutoUpgradeToPaid": true,
