    "openrouter_free": {
      "perDay": 50,
      "perDayAfter10UsdLifetime": 1000,
      "perMinute": 20
    },
    "retryDelaySeconds": 60,
    "sambanova_free": {
      "note": "Free tier, no card — verify the current roster and caps in the SambaNova console."
    }
  },
