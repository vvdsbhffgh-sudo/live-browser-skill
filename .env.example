# Port the server runs on (HTTP mode + Live View). Default: 3100
LIVE_BROWSER_PORT=3100

# Where the persistent Chromium profile lives (Google session included).
# Default: ./.live-browser-profile
LIVE_BROWSER_PROFILE=./.live-browser-profile

# 1 = show a visible browser window (needed for manual Google sign-in).
# 0 = headless (default).
LIVE_BROWSER_HEADED=0

# --- Wave 2 ---
# 1 = read-only: clicking and typing are blocked. Default: 0
LIVE_BROWSER_READONLY=0

# 1 = allow sensitive actions (delete/send/publish). Default: 0 (blocked).
LIVE_BROWSER_ALLOW_SENSITIVE=0

# Max mutating browser actions per server run. Default: 100
LIVE_BROWSER_MAX_STEPS=100

# Comma-separated domain lists. Blocked wins; a non-empty allow list
# restricts browsing to those hosts (subdomains included). Empty = no restriction.
LIVE_BROWSER_ALLOWED_DOMAINS=
LIVE_BROWSER_BLOCKED_DOMAINS=

# --- Wave 3 ---
# URL of your own Artemis MCP server (Google Artemis, real Android phone).
# Unset = phone_status reports "not-configured" and the skill never touches
# a phone. See docs/ARTEMIS.md. No Artemis code is included in this repo.
ARTEMIS_MCP_URL=

# Windows desktop (Microsoft UFO) and iPhone (iphone-control) endpoints.
# Unset = windows_status / iphone_status report "not-configured".
# See docs/PLATFORMS.md. No UFO or iphone-control code is included here.
UFO_MCP_URL=
IPHONE_CONTROL_URL=

# Starting mode: coding, content, research, testing, or chat. Default: coding.
# See config/modes/ and the browser_mode tool.
ATLAS_MODE=coding

# Model router / multi-agent / plugins are config files, not env vars:
#   config/model-router.example.json -> config/model-router.json
#   config/agents.example.json      -> config/agents.json
#   plugins/registry.example.json   -> plugins/registry.json
# Copy the .example file and edit it; the real config is git-ignored.
